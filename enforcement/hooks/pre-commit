#!/bin/sh
# vedev_agents — protege ramas compartidas y evita subir .env reales.
# Ramas protegidas: VEDEV_PROTECTED_BRANCHES (por defecto "main develop").
# Excepción puntual: VEDEV_ALLOW_PROTECTED=1 git commit ...

# Primer commit del repositorio: se permite.
git rev-parse --verify HEAD >/dev/null 2>&1 || exit 0

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
protected=${VEDEV_PROTECTED_BRANCHES:-"main develop"}

if [ "${VEDEV_ALLOW_PROTECTED:-0}" != "1" ]; then
  for b in $protected; do
    if [ "$branch" = "$b" ]; then
      echo "vedev: no se hacen commits directos a '$branch'. Crea una rama (feat/..., fix/...) y abre un Pull Request." >&2
      exit 1
    fi
  done
fi

envs=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..+)?$' | grep -v '\.env\.example$')
if [ -n "$envs" ]; then
  echo "vedev: estás intentando versionar archivos .env reales:" >&2
  echo "$envs" | sed 's/^/  - /' >&2
  echo "Quítalos con: git restore --staged <archivo>  y verifica tu .gitignore" >&2
  exit 1
fi

exit 0
